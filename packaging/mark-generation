#!/bin/sh
set -eu

marker=${CATDOT_SYSTEM_GENERATION:-/var/lib/catdot/generation}
state_dir=$(dirname "$marker")
install -d -m 0755 "$state_dir"
generation=0
if test -r "$marker"; then
  generation=$(cat "$marker")
fi
case $generation in
  *[!0-9]*|'') generation=0 ;;
esac
temporary=$(mktemp "$state_dir/.generation.XXXXXX")
cleanup() { rm -f "$temporary"; }
trap cleanup EXIT HUP INT TERM
printf '%s\n' "$((generation + 1))" >"$temporary"
chmod 0644 "$temporary"
mv -f "$temporary" "$marker"
trap - EXIT HUP INT TERM
