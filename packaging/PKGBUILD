pkgname=catdot
pkgver=0.1.0
pkgrel=1
pkgdesc='CatOS complete configuration profile switcher'
arch=('x86_64')
url='https://github.com/CatOS-dev/catdot'
license=('GPL-3.0-or-later')
depends=('pacman' 'polkit' 'libalpm.so=16-64')
makedepends=('cargo')
source=("${pkgname}-${pkgver}.tar.gz::${url}/archive/refs/tags/v${pkgver}.tar.gz")
# The v${pkgver} archive does not exist yet. Replace SKIP with its verified
# checksum when publishing the corresponding release tag.
sha256sums=('SKIP')

build() {
  cd "${srcdir}/${pkgname}-${pkgver}"
  cargo build --release --locked
}

package() {
  cd "${srcdir}/${pkgname}-${pkgver}"
  sh packaging/install.sh "$PWD" "$pkgdir"
}
