pkgname=catdot
pkgver=0.1.0
pkgrel=1
pkgdesc='CatOS system desktop profile manager'
arch=('x86_64')
license=('GPL-3.0-or-later')
depends=('pacman' 'polkit' 'libalpm.so=16-64')
makedepends=('cargo')
source=()
sha256sums=()

build() {
  cd "$startdir/.."
  cargo build --release --locked
}

package() {
  cd "$startdir/.."
  install -Dm755 target/release/catdot "$pkgdir/usr/bin/catdot"
  install -Dm755 target/release/catdot-helper "$pkgdir/usr/lib/catdot/catdot-helper"
  install -Dm644 packaging/org.catos.catdot.policy "$pkgdir/usr/share/polkit-1/actions/org.catos.catdot.policy"
  install -d "$pkgdir/usr/share/catdot/profiles"
  cp -a profiles/. "$pkgdir/usr/share/catdot/profiles/"
}
